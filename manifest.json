{
  "id": "subscriptions",
  "name": "Subscriptions & Bills",
  "version": "1.0.0",
  "description": "One shared list of everything the household pays for on repeat — streaming, software, memberships, utilities — with renewal countdowns and a real monthly total.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": ["subscriptions", "bills", "money", "renewals", "budget"],
  "icon": "💳",
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "automation_actions": {
    "add_subscription": {
      "title": "Track a subscription",
      "description": "Start tracking a recurring cost when another app's event fires — a trial started, a service signed up for, a renewal noticed elsewhere.",
      "params": {
        "created_by": {
          "type": "member",
          "label": "Added by",
          "required": true
        },
        "name": {
          "type": "text",
          "label": "Service name",
          "required": true
        },
        "amount_cents": {
          "type": "integer",
          "label": "Amount per period (in cents)",
          "default": 0,
          "min": 0
        },
        "billing_period": {
          "type": "text",
          "label": "Billing period",
          "default": "monthly",
          "options": ["weekly", "monthly", "yearly"]
        }
      },
      "dedupe": {
        "table": "subscriptions",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "subscriptions",
          "values": {
            "id": "$uuid",
            "name": ":name",
            "amount_cents": ":amount_cents",
            "billing_period": ":billing_period",
            "created_by": ":created_by",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "db_plaintext_columns": ["billing_period", "next_renewal_date"],
    "member_references": {
      "subscriptions": [
        {
          "column": "created_by",
          "on_removed": "keep"
        },
        {
          "column": "payer_id",
          "on_removed": "keep"
        }
      ]
    },
  "row_policies": {
    "subscriptions": {
      "kind": "adult_writable"
    }
  },
  "publishes": ["subscription.added"],
  "publish_acls": {
    "subscription.added": { "require_role": "adult" }
  },
  "nav": { "label": "Subscriptions" },
  "agenda": {
    "kind": "reminder",
    "label": "Renews today",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, name AS title, NULLIF(billing_period, '') AS subtitle, next_renewal_date AS when_at, NULLIF(payer_id, '') AS member_id FROM app_subscriptions__subscriptions WHERE status = 'active' AND next_renewal_date = :today ORDER BY created_at LIMIT 20"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT name AS title, billing_period AS subtitle, next_renewal_date AS renews_on, NULLIF(payer_id, '') AS payer FROM app_subscriptions__subscriptions WHERE status = 'active' AND next_renewal_date >= :today ORDER BY next_renewal_date LIMIT 3"
    },
    "display": { "template": "list", "title": "title", "subtitle": "subtitle", "when": "renews_on", "owner": "payer" }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["active_subscriptions"]
  }
}
